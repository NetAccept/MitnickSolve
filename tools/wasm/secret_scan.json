{
  "name": "secret_scan",
  "description": "Scan text files for credential-shaped strings; previews are redacted.",
  "input_schema": {
    "type": "object",
    "required": [
      "env_id"
    ],
    "properties": {
      "env_id": {
        "type": "string",
        "description": "Environment identifier returned by envd."
      },
      "root": {
        "type": "string",
        "description": "Workspace-relative directory to walk (defaults to the workspace root).",
        "default": "."
      },
      "glob": {
        "type": "string",
        "description": "Optional glob filter applied to relative paths or base names."
      },
      "max_files": {
        "type": "integer",
        "description": "Maximum files to scan.",
        "minimum": 1,
        "maximum": 5000,
        "default": 1000
      },
      "max_file_bytes": {
        "type": "integer",
        "description": "Maximum bytes read per file.",
        "minimum": 1,
        "maximum": 4194304,
        "default": 524288
      },
      "include_hidden": {
        "type": "boolean",
        "description": "Include hidden files and directories.",
        "default": false
      }
    }
  },
  "capabilities": [
    "fs.workspace"
  ]
}
