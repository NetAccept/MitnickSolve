{
  "name": "finding_list",
  "description": "List structured security findings from the shared assessment ledger, filtered by severity, status, asset or tag and sorted by severity.",
  "input_schema": {
    "type": "object",
    "properties": {
      "severity": {
        "type": "string",
        "enum": ["info", "low", "medium", "high", "critical"]
      },
      "status": {
        "type": "string",
        "enum": ["open", "confirmed", "fixed", "false_positive"]
      },
      "asset": {"type": "string"},
      "tag": {"type": "string"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}
    }
  },
  "capabilities": ["state.shared"]
}
